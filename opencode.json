{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "node",
        "node_modules/@playwright/mcp/cli.js",
        "--headless",
        "--browser",
        "chrome",
        "--isolated",
        "--viewport-size",
        "1280x720",
        "--output-dir",
        "evidence/raw/mcp"
      ],
      "enabled": true,
      "timeout": 120000
    }
  }
}
